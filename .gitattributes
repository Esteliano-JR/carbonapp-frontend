* text=auto

# Código (sempre LF)
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env    text eol=lf

# Docker (se usar)
Dockerfile text eol=lf
